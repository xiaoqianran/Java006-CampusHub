# 复制为 .env 后填写本机或部署环境的值；.env 已被 Git 忽略。
MYSQL_ROOT_PASSWORD=
USER_DB_USER=root
USER_DB_PASSWORD=
RESOURCE_DB_USER=root
RESOURCE_DB_PASSWORD=

# 生产/多实例建议使用 minio；本地可设为 local。
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=http://127.0.0.1:9000
# 浏览器可访问的 MinIO HTTPS 域名；留空时文件由资源服务代理输出。
MINIO_PUBLIC_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=campushub-resources
STORAGE_SIGNED_URL_TTL=10m
STORAGE_TEMPORARY_TTL=24h
LOCAL_STORAGE_ROOT=uploads/objects

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_OPEN=false
CACHE_DEFAULT_TTL=15m
CACHE_RESOURCE_DETAIL_TTL=20m
CACHE_CATEGORY_TREE_TTL=60m
CACHE_NULL_TTL=60s
CACHE_TTL_JITTER=5m

# 资源服务调用用户服务的内网凭据；请使用至少 32 字节随机值，并在两端保持一致。
INTERNAL_SERVICE_KEY=
USER_SERVICE_URL=http://localhost:8081
USER_CLIENT_CONNECT_TIMEOUT_MS=1000
USER_CLIENT_READ_TIMEOUT_MS=2000
RBAC_AUTHORITY_CACHE_TTL=24h

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
RABBITMQ_CONSUMER_CONCURRENCY=2
RABBITMQ_CONSUMER_MAX_CONCURRENCY=8
RABBITMQ_CONSUMER_PREFETCH=20

# 资源 Outbox：失败会指数退避，达到上限后进入 DEAD，不会无限重试。
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_BASE_BACKOFF=5s
OUTBOX_MAX_BACKOFF=10m
OUTBOX_CLAIM_TIMEOUT=2m
OUTBOX_CONFIRM_TIMEOUT=5s
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_INITIAL_DELAY_MS=3000
RABBIT_QUEUE_MONITOR_ENABLED=true
RABBIT_QUEUE_WARNING_THRESHOLD=1000
RABBIT_QUEUE_MONITOR_INTERVAL_MS=15000
RABBIT_QUEUE_MONITOR_INITIAL_DELAY_MS=15000

# Jimeng local synchronization (generate a random value of at least 32 characters)
JIMENG_INGEST_TOKEN=
JIMENG_IMPORT_USER_ID=1
JIMENG_ALLOWED_IMAGE_HOSTS=p11-dreamina-sign.byteimg.com,p26-dreamina-sign.byteimg.com
JIMENG_SYNC_ALLOWED_ORIGIN=https://jimeng.jianying.com

# 至少 32 字节的随机字符串，所有后端服务必须一致。
JWT_SECRET=

GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
